;fontSize=11;align=left;spacingLeft=6;" value="vigencia_fim" vertex="1"><mxGeometry height="26" width="160" x="60" as="geometry"><mxRectangle height="26" width="160" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_PROGRAMA_FIDELIDADE_r5_c2" parent="t_PROGRAMA_FIDELIDADE_r5" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontColor=#555555;" value="DATE NULL" vertex="1"><mxGeometry height="26" width="130" x="220" as="geometry"><mxRectangle height="26" width="130" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_CONSUMO_PONTOS_r2" parent="t_CONSUMO_PONTOS" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#b46504;" value="" vertex="1"><mxGeometry height="26" width="350" y="82" as="geometry" /></mxCell><mxCell id="t_CONSUMO_PONTOS_r2_c0" parent="t_CONSUMO_PONTOS_r2" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;" value="" vertex="1"><mxGeometry height="26" width="60" as="geometry"><mxRectangle height="26" width="60" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_CONSUMO_PONTOS_r2_c1" parent="t_CONSUMO_PONTOS_r2" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" value="pontos_consumidos" vertex="1"><mxGeometry height="26" width="160" x="60" as="geometry"><mxRectangle height="26" width="160" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_CONSUMO_PONTOS_r2_c2" parent="t_CONSUMO_PONTOS_r2" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontColor=#555555;" value="INT" vertex="1"><mxGeometry height="26" width="130" x="220" as="geometry"><mxRectangle height="26" width="130" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_CUPOM_PROMOCIONAL_r10" parent="t_CUPOM_PROMOCIONAL" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#666666;" value="" vertex="1"><mxGeometry height="26" width="350" y="290" as="geometry" /></mxCell><mxCell id="t_CUPOM_PROMOCIONAL_r10_c0" parent="t_CUPOM_PROMOCIONAL_r10" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;" value="" vertex="1"><mxGeometry height="26" width="60" as="geometry"><mxRectangle height="26" width="60" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_CUPOM_PROMOCIONAL_r10_c1" parent="t_CUPOM_PROMOCIONAL_r10" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" value="valor_maximo_desconto" vertex="1"><mxGeometry height="26" width="160" x="60" as="geometry"><mxRectangle height="26" width="160" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="t_CUPOM_PROMOCIONAL_r10_c2" parent="t_CUPOM_PROMOCIONAL_r10" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontColor=#555555;" value="DECIMAL(10,2) NULL" vertex="1"><mxGeometry height="26" width="130" x="220" as="geometry"><mxRectangle height="26" width="130" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="e_lote_pedido" edge="1" parent="1" source="t_PONTOS_FIDELIDADE" target="t_PEDIDO" style="edgeStyle=none;html=1;rounded=0;startArrow=ERzeroToOne;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;strokeColor=#333333;exitX=1;exitY=0.3992;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.958;entryDx=0;entryDy=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3060" y="175" /><mxPoint x="3060" y="1760" /><mxPoint x="1780" y="1760" /><mxPoint x="1780" y="1048" /></Array></mxGeometry></mxCell><mxCell id="e_lote_programa" edge="1" parent="1" source="t_PONTOS_FIDELIDADE" target="t_PROGRAMA_FIDELIDADE" style="edgeStyle=none;html=1;rounded=0;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;strokeColor=#333333;exitX=0.15;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8357;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nota_fidelidade" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#fff5e6;strokeColor=#b46504;fontSize=12;" value="&lt;b&gt;Como os Pontos Fidelidade são adquiridos&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Cada pedido ENTREGUE (RN-11) gera &lt;b&gt;um lote&lt;/b&gt; em PONTOS_FIDELIDADE (pedido_id UK).&lt;br&gt;• Acúmulo: pontos_creditados = FLOOR(total pago × pontos_por_real).&lt;br&gt;&amp;nbsp;&amp;nbsp;Hoje: 1 ponto por R$ 1,00 (tela 10: R$ 63,60 → 63 pts).&lt;br&gt;• Resgate: cada ponto vale valor_ponto_resgate em desconto.&lt;br&gt;&amp;nbsp;&amp;nbsp;Hoje: R$ 0,05 por ponto (100 pts = R$ 5,00).&lt;br&gt;• Logo, não é um campo &quot;percentual de cashback&quot;: o retorno efetivo&lt;br&gt;&amp;nbsp;&amp;nbsp;é pontos_por_real × valor_ponto_resgate = 1 × 0,05 = &lt;b&gt;5%&lt;/b&gt; do valor pago.&lt;br&gt;• Validade: data_expiracao = data_credito + validade_meses (6).&lt;br&gt;• Uso: PAGAMENTO_PONTOS debita pontos; CONSUMO_PONTOS diz de quais&lt;br&gt;&amp;nbsp;&amp;nbsp;lotes saíram e quanto (pontos_consumidos), baixando pontos_restantes.&lt;br&gt;• Saldo do cliente = soma de pontos_restantes dos lotes não expirados.&lt;br&gt;• A regra fica em PROGRAMA_FIDELIDADE com vigência, então mudar a&lt;br&gt;&amp;nbsp;&amp;nbsp;regra não altera lotes antigos (cada lote guarda seu programa).&lt;br&gt;&lt;br&gt;&lt;b&gt;Restrições&lt;/b&gt;&lt;br&gt;• CHECK 0 &amp;lt;= pontos_restantes &amp;lt;= pontos_creditados; pontos_consumidos &amp;gt; 0&lt;br&gt;• Trigger: soma de pontos_consumidos = PAGAMENTO_PONTOS.pontos_debitados,&lt;br&gt;&amp;nbsp;&amp;nbsp;consumindo primeiro os lotes que vencem antes&lt;br&gt;• Pedido CANCELADO: estorna o lote gerado e devolve pontos consumidos" vertex="1"><mxGeometry x="2240" y="1800" width="560" height="330" as="geometry" /></mxCell><mxCell id="nota_cupom" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;Cupom Promocional: campos e uso múltiplo&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Cada cupom pertence a &lt;b&gt;um cliente&lt;/b&gt;: UK1 (cliente_id, codigo).&lt;br&gt;• &lt;b&gt;Sim, o mesmo cupom pode ser usado mais de uma vez&lt;/b&gt;, pelo mesmo&lt;br&gt;&amp;nbsp;&amp;nbsp;cliente, em pedidos diferentes, até limite_usos. Cada uso é uma linha&lt;br&gt;&amp;nbsp;&amp;nbsp;em USO_CUPOM. Ex.: BEMVINDO10 com limite_usos = 1; FRETEGRATIS = 3.&lt;br&gt;• Um pedido usa no máximo um cupom: USO_CUPOM.pedido_id é UK.&lt;br&gt;&lt;br&gt;• percentual_desconto: % sobre a soma dos itens (0 se só isenta frete)&lt;br&gt;• valor_maximo_desconto: teto do desconto em R$ (NULL = sem teto)&lt;br&gt;• isenta_taxa_entrega: zera a taxa; só vale na modalidade ENTREGA&lt;br&gt;• valor_minimo_pedido: soma dos itens mínima para aplicar o cupom&lt;br&gt;• validade_inicio / validade_fim: período em que o cupom pode ser usado&lt;br&gt;• limite_usos: nº máximo de pedidos confirmados que podem usar o cupom&lt;br&gt;• USO_CUPOM.valor_descontado: valor efetivamente abatido naquele pedido&lt;br&gt;&lt;br&gt;&lt;b&gt;Restrições&lt;/b&gt;&lt;br&gt;• CHECK 0 &amp;lt;= percentual_desconto &amp;lt;= 100; validade_inicio &amp;lt;= validade_fim;&lt;br&gt;&amp;nbsp;&amp;nbsp;limite_usos &amp;gt;= 1; (percentual_desconto &amp;gt; 0 OR isenta_taxa_entrega)&lt;br&gt;• Trigger: nº de USO_CUPOM do cupom em pedidos não cancelados &amp;lt;= limite_usos" vertex="1"><mxGeometry x="1360" y="1800" width="560" height="330" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>